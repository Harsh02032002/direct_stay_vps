# GEMINI_API_KEY: Optional for Gemini AI Advisor calls.
GEMINI_API_KEY=""

# Server Port
PORT=3005
NODE_ENV=production

# MONGODB ATLAS CLOUD DATABASE CONFIGURATION
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hotel?retryWrites=true&w=majority"
DIRECT_REPLICA_MONGODB_URI=""

# HOSTINGER SMTP EMAIL CONFIGURATION
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="mail@directstay.online"
SMTP_PASS="<your-smtp-password>"
SMTP_FROM='"DirectStay Cloud PMS" <mail@directstay.online>'
